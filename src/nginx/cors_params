# CORS отключён: same-origin запросы (схема+хост+порт совпадают) не требуют CORS,
# авторизация чужих origin'ов браузером не выполняется

# Обработка Preflight (OPTIONS): обрываем на edge, не проксируя в бэкенды
if ($request_method = 'OPTIONS') {
    add_header 'Content-Type' 'text/plain; charset=utf-8' always;
    add_header 'Content-Length' 0 always;
    return 204;
}

# подавляем CORS-заголовки, которые могут слать апстримы (api-gateway, monolith)
proxy_hide_header 'Access-Control-Allow-Origin';
proxy_hide_header 'Access-Control-Allow-Credentials';
